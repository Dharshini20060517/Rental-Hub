{
  "info": {
    "name": "RentalHub",
    "_postman_id": "rentalhub-phase1-2-3-collection",
    "description": "RentalHub equipment rental platform — Phase 1 (marketplace) + Phase 2 (booking & rental lifecycle) + Phase 3 (analytics & intelligence) REST API (v1).\n\nUse the `{{base_url}}` variable (default http://localhost:3000). Auth uses httpOnly cookies set automatically by Postman — no manual Authorization header needed after login.\n\nPhase 2 booking lifecycle: PENDING → HELD → CONFIRMED → PICKED_UP → IN_USE → RETURN_PENDING → RETURNED → INSPECTED → COMPLETED (plus CANCELLED / LATE / DISPUTED). See the Bookings folder for the lifecycle endpoints and the API_CONTRACT.md §5.1 state machine.\n\nDemo accounts (seeded):\n- admin@rentalhub.test / Admin123!\n- rohit@rentalhub.test / Owner123!\n- rahul@rentalhub.test / Customer123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "equipment_id", "value": "REPLACE_WITH_EQUIPMENT_CUID", "type": "string" },
    { "key": "category_id", "value": "REPLACE_WITH_CATEGORY_CUID", "type": "string" },
    { "key": "user_id", "value": "REPLACE_WITH_USER_CUID", "type": "string" },
    { "key": "block_id", "value": "REPLACE_WITH_BLOCK_CUID", "type": "string" },
    { "key": "log_id", "value": "REPLACE_WITH_LOG_CUID", "type": "string" },
    { "key": "window_id", "value": "REPLACE_WITH_WINDOW_CUID", "type": "string" },
    { "key": "image_id", "value": "REPLACE_WITH_IMAGE_CUID", "type": "string" },
    { "key": "booking_id", "value": "REPLACE_WITH_BOOKING_CUID", "type": "string" },
    { "key": "payment_id", "value": "REPLACE_WITH_PAYMENT_CUID", "type": "string" },
    { "key": "dispute_id", "value": "REPLACE_WITH_DISPUTE_CUID", "type": "string" },
    { "key": "suggestion_id", "value": "REPLACE_WITH_SUGGESTION_CUID", "type": "string" },
    { "key": "reset_token", "value": "REPLACE_WITH_RESET_TOKEN", "type": "string" }
  ],
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": [""] }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication, profile, avatar, password reset. Cookies are used for session — no manual token header.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}" }
          }
        },
        {
          "name": "Login (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rahul@rentalhub.test\",\n  \"password\": \"Customer123!\"\n}" }
          }
        },
        {
          "name": "Login (owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rohit@rentalhub.test\",\n  \"password\": \"Owner123!\"\n}" }
          }
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@rentalhub.test\",\n  \"password\": \"Admin123!\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/profile", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"+91 90000 00000\",\n  \"bio\": \"Updated bio text.\"\n}" }
          }
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "multipart/form-data" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/avatar", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "avatar"] },
            "body": { "mode": "formdata", "formdata": [{ "key": "avatar", "type": "file", "src": [] }] }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/forgot-password", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rahul@rentalhub.test\"\n}" }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/reset-password", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"NewPassword123!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Category taxonomy. Admin-only writes.",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/categories", "host": ["{{base_url}}"], "path": ["api", "v1", "categories"] }
          }
        },
        {
          "name": "Create category (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/categories", "host": ["{{base_url}}"], "path": ["api", "v1", "categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Garden Tools\",\n  \"slug\": \"garden-tools\",\n  \"description\": \"Lawnmowers, trimmers and garden equipment.\"\n}" }
          }
        },
        {
          "name": "Get category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "categories", "{{category_id}}"] }
          }
        },
        {
          "name": "Update category (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "categories", "{{category_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description.\"\n}" }
          }
        },
        {
          "name": "Delete category (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/v1/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "categories", "{{category_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "description": "Equipment listings: search, CRUD, my, compare, images.",
      "item": [
        {
          "name": "Search marketplace",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/equipment?q=drill&category=power-tools&minPrice=100&maxPrice=400&city=Mumbai&minRating=4&sort=price&order=asc&page=1&limit=12&status=active", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment"], "query": [
              { "key": "q", "value": "drill" },
              { "key": "category", "value": "power-tools" },
              { "key": "minPrice", "value": "100" },
              { "key": "maxPrice", "value": "400" },
              { "key": "city", "value": "Mumbai" },
              { "key": "minRating", "value": "4" },
              { "key": "sort", "value": "price" },
              { "key": "order", "value": "asc" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "12" },
              { "key": "status", "value": "active" }
            ] }
          }
        },
        {
          "name": "Search with geo radius",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/equipment?lat=19.076&lng=72.8777&radiusKm=50&sort=distance&order=asc", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment"], "query": [
              { "key": "lat", "value": "19.076" },
              { "key": "lng", "value": "72.8777" },
              { "key": "radiusKm", "value": "50" },
              { "key": "sort", "value": "distance" },
              { "key": "order", "value": "asc" }
            ] }
          }
        },
        {
          "name": "Create listing (owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/equipment", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Bosch GSB 550W Impact Drill\",\n  \"description\": \"Well maintained 550W impact drill with 13mm chuck. Suitable for wood, metal and masonry.\",\n  \"categoryId\": \"{{category_id}}\",\n  \"status\": \"draft\",\n  \"condition\": \"like_new\",\n  \"baseDailyPrice\": 250,\n  \"baseHourlyPrice\": 40,\n  \"baseDeposit\": 500,\n  \"replacementValue\": 4500,\n  \"lat\": 19.076,\n  \"lng\": 72.8777,\n  \"city\": \"Mumbai\",\n  \"address\": \"Mumbai\",\n  \"bufferHours\": 2,\n  \"pricingRules\": [\n    { \"type\": \"weekend_surcharge\", \"value\": 15, \"unit\": \"percent\" },\n    { \"type\": \"long_discount\", \"value\": 10, \"unit\": \"percent\", \"minDays\": 7, \"label\": \"7+ days -10%\" }\n  ],\n  \"specs\": [\n    { \"key\": \"Power\", \"value\": \"550W\" },\n    { \"key\": \"Chuck\", \"value\": \"13mm\" }\n  ]\n}" }
          }
        },
        {
          "name": "My listings (owner)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/equipment/my?page=1&limit=12&status=active", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "my"], "query": [
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "12" },
              { "key": "status", "value": "active" }
            ] }
          }
        },
        {
          "name": "Compare (2-3 ids)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/equipment/compare?ids=ID_A,ID_B,ID_C", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "compare"], "query": [{ "key": "ids", "value": "ID_A,ID_B,ID_C" }] }
          }
        },
        {
          "name": "Get equipment detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}?lat=19.076&lng=72.8777", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}"], "query": [
              { "key": "lat", "value": "19.076" },
              { "key": "lng", "value": "72.8777" }
            ] }
          }
        },
        {
          "name": "Update listing (owner)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\",\n  \"baseDailyPrice\": 260,\n  \"specs\": [\n    { \"key\": \"Power\", \"value\": \"550W\" },\n    { \"key\": \"Chuck\", \"value\": \"13mm\" },\n    { \"key\": \"Weight\", \"value\": \"1.8 kg\" }\n  ]\n}" }
          }
        },
        {
          "name": "Delete listing (owner)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}"] }
          }
        },
        {
          "name": "Upload images (owner, multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "multipart/form-data" }],
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}/images", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}", "images"] },
            "body": { "mode": "formdata", "formdata": [{ "key": "images", "type": "file", "src": [] }] }
          }
        },
        {
          "name": "Set primary image (owner)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}/images", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}", "images"] },
            "body": { "mode": "raw", "raw": "{\n  \"imageId\": \"{{image_id}}\",\n  \"isPrimary\": true,\n  \"order\": 0\n}" }
          }
        },
        {
          "name": "Delete image (owner)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/v1/equipment/{{equipment_id}}/images/{{image_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "equipment", "{{equipment_id}}", "images", "{{image_id}}"] }
          }
        }
      ]
    },
